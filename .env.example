# Статический ключ для заголовка X-API-Key
API_KEY=secret-api-key

# Политика ретраев (общая для всех сервисов — задаёт TTL retry-очередей)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MULTIPLIER=2

# Сколько сообщений одновременно обрабатывает один consumer
RABBITMQ_PREFETCH_COUNT=16
# Для процессора — отдельно (ждёт шлюз, БД не использует)
PROCESSOR_PREFETCH_COUNT=100

# Процессы uvicorn в payments-api (у каждого свой пул БД 5+5)
API_WORKERS=4

# Эмулятор шлюза
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_MIN_LATENCY_S=2
GATEWAY_MAX_LATENCY_S=5
# Доля ответов 503 — включите (например, 0.3), чтобы увидеть ретраи процессора
GATEWAY_TRANSIENT_FAILURE_RATE=0
